{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes",
  "version": "1.0.0",
  "identifier": "ai.nousresearch.hermes.grokbot",
  "build": {
    "beforeDevCommand": "npm --workspace=@grok-bot/hermes-web run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Hermes",
        "width": 1360,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
