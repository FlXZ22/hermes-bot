{
  "name": "hermes-grok-bot-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Grok Bot themed desktop and reusable web application for Hermes Agent on Linux",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=@grok-bot/hermes-web run dev",
    "build:theme": "npm --workspace=@grok-bot/theme run build",
    "build:client": "npm --workspace=@grok-bot/hermes-client run build",
    "build:web": "npm --workspace=@grok-bot/hermes-web run build",
    "build": "npm run build:theme && npm run build:client && npm run build:web",
    "desktop": "npm run desktop:dev",
    "typecheck": "tsc --noEmit -p packages/grok-bot-theme/tsconfig.json && tsc --noEmit -p packages/hermes-client/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "npm run build:client && node --test tests/*.test.mjs",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json --no-bundle",
    "desktop:install": "bash scripts/install-linux.sh",
    "desktop:tauri:preview:install": "bash scripts/install-linux.sh --preview",
    "desktop:tauri:activate": "bash scripts/install-linux.sh --activate",
    "dev:connected": "node scripts/dev-connected.mjs",
    "test:integration": "npm run build:client && node scripts/hermes-smoke.mjs",
    "test:e2e": "npm run build:client && node scripts/hermes-e2e.mjs",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:diagnose": "cargo run --manifest-path apps/desktop/src-tauri/Cargo.toml -- --diagnose-backend",
    "test:auth": "npm run build:client && node scripts/hermes-auth-e2e.mjs",
    "test:chat-ui": "node scripts/chat-ui-check.cjs",
    "test:work-ui": "node scripts/work-ui-check.cjs",
    "test:desktop-perf": "node scripts/webkit-perf.mjs",
    "test:desktop-perf:gate": "node scripts/desktop-performance-gate.mjs",
    "test:desktop-memory": "node scripts/desktop-memory.mjs",
    "test:tauri:smoke": "npm run build && cargo build --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --features desktop-qa --bin hermes-grok-bot --jobs 2 && node scripts/chromium-smoke.mjs --tauri apps/desktop/src-tauri/target/debug/hermes-grok-bot",
    "desktop:chromium:build": "node scripts/prepare-electron.cjs && npm run build && cargo build --locked --manifest-path apps/desktop/src-tauri/Cargo.toml --release --no-default-features --bin hermes-native --jobs 2",
    "desktop:chromium": "electron apps/chromium/main.cjs",
    "test:chromium:perf": "node scripts/chromium-perf.mjs",
    "test:chromium:smoke": "node scripts/chromium-smoke.mjs",
    "desktop:chromium:install": "bash scripts/install-chromium.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "45.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
